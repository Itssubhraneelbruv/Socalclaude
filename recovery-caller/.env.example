# Copy to .env.local (in this folder or any parent) and fill in.
# .env.local is gitignored - never commit real keys.

# Anthropic - console.anthropic.com
ANTHROPIC_API_KEY=""

# ElevenLabs - elevenlabs.io/app/settings/api-keys
# The key needs ElevenAgents: Write (plus Text to Speech: Access). A default
# restricted key fails with "missing the permission convai_read".
ELEVENLABS_API_KEY=""

# Twilio - console.twilio.com -> API keys & auth tokens -> AUTH TOKENS tab.
# Must be the account Auth Token, NOT an API Key secret (SK...): ElevenLabs
# authenticates to Twilio as AccountSID:AuthToken.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""   # E.164, the caller ID, e.g. +12138389789

# Written by the setup scripts - run these once, then paste the IDs back here:
#   python setup_phone.py             -> ELEVENLABS_PHONE_NUMBER_ID
#   python setup_recovery_agent.py    -> ELEVENLABS_RECOVERY_AGENT_ID
ELEVENLABS_PHONE_NUMBER_ID=""
ELEVENLABS_RECOVERY_AGENT_ID=""

# Who the dashboard button calls, E.164. On a Twilio trial this number must first
# be added under Phone Numbers -> Verified Caller IDs.
TARGET_PHONE_NUMBER=""
